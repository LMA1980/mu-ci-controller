# ==============================================================================
# Mu-CI Distributed Controller Configuration Environment
# Path: /etc/mu-ci-controller/controller.env (Permissions: 0600 mu-ci-controller:mu-ci-controller)
# ==============================================================================

# TCP bind address for the controller daemon
MU_CI_CONTROLLER_BIND=0.0.0.0:8000

# Base workspace directory on the controller host
MU_CI_CONTROLLER_WORKSPACE=/var/lib/mu-ci-controller/workspace

# Allowed repository glob pattern for GitHub webhook ingestion
MU_CI_CONTROLLER_ALLOWED_REPOS=LMA1980/*

# Path to GitHub Webhook HMAC secret file (or literal secret token)
GITHUB_WEBHOOK_SECRET=/etc/mu-ci-controller/github_webhook_secret

# Path to Shared Cluster Worker Authentication Token (or literal token)
MU_CI_CONTROLLER_CLUSTER_TOKEN=/etc/mu-ci-controller/cluster_token

# Maximum concurrent jobs executed simultaneously across the cluster (default: 6)
MU_CI_CONTROLLER_MAX_CONCURRENT_JOBS=6

# GitHub Personal Access Token / App token for reporting commit status checks (continuous integration)
# Path to token file (recommended) or literal token
GITHUB_TOKEN=/etc/mu-ci-controller/github_token

# API key for log access and for private repositories in the read-only console API
# (/api/repos*). Path to key file (recommended) or literal key. Unset = private repos never served.
# MU_CI_CONTROLLER_LOG_API_KEY=/etc/mu-ci-controller/log_api_key

# Optional dedicated read-only service bearer token file for least-privilege canary/inspection probes
# (/health, /api/ha/status, /api/cluster/nodes, /api/auth/folios GET, /api/queue, /api/repos* GET, /api/jobs* GET).
# Strictly file-path only (fails closed if missing, unreadable, or empty); fallback var: MU_CI_READONLY_TOKEN_FILE.
# MU_CI_CONTROLLER_READONLY_TOKEN_FILE=/etc/mu-ci-controller/ci-readonly.token

# Console API: GitHub REST base URL for .gitmodules / workflow lookups ("off" disables)
# MU_CI_CONTROLLER_GITHUB_API_URL=https://api.github.com
# Console API: freshness window for cached repository metadata and submodules (seconds)
# MU_CI_CONTROLLER_CONSOLE_METADATA_TTL_SECS=21600
# Console API: optional comma-separated owner/repo list retired on startup
# MU_CI_CONTROLLER_RETIRED_REPOS=

# High Availability & Shared MuObserve Persistence (default: single-leader on node-a)
# MU_CI_CONTROLLER_NODE_ID=node-a
# MU_CI_CONTROLLER_HA_ROLE=auto
# MU_CI_CONTROLLER_LEASE_TTL_SECS=15
# MU_CI_CONTROLLER_STANDBY_SYNC_SECS=5
# MU_CI_CONTROLLER_STORAGE_MODE=remote
# MUOBSERVE_CONTROL_ADDR=muobserve.node-a.cluster.internal:9443

# Tracing and logging level
RUST_LOG=info,mu_ci_controller=debug
